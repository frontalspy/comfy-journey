{
  "name": "@comfy/server",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run copy:migrations",
    "copy:migrations": "node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:backup": "tsx src/db/runBackupOnce.ts",
    "start:fake": "tsx src/test/fakeComfyMain.ts"
  },
  "dependencies": {
    "@comfy/shared": "*",
    "@libsql/client": "^0.15.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.4",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.4",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  }
}

# Copy to .env and edit. Every value here is a placeholder; nothing is read from this file itself.

# Where the server listens. Loopback by default: the app is private until you choose otherwise.
HOST=127.0.0.1
PORT=3000

# Your ComfyUI. Server-side only: it is never sent to the browser.
COMFYUI_URL=http://127.0.0.1:8188

# Where the database, images and backups live (default: ./data).
# DATA_DIR=./data

# Who may use the app. One of: none, proxy-header, token, module.
#   none          single user; only allowed while HOST is a loopback address
#   proxy-header  a reverse proxy you trust sets the user header (see TRUSTED_PROXIES)
#   token         shared secrets: AUTH_TOKENS=alice=<16+ characters>,bob=<16+ characters>
#   module        AUTH_MODULE=/path/to/your-auth-provider.js
AUTH_MODE=none
# AUTH_TOKENS=
# AUTH_HEADER=x-forwarded-user
# TRUSTED_PROXIES=127.0.0.1,::1

# Optional: delete finished jobs' files from ComfyUI (needs the job_cleanup extension).
# COMFYUI_CLEANUP_TOKEN=

# Optional: share the GPU with other software; a file exporting a GpuGate factory.
# GPU_GATE_MODULE=

# Optional: keep images and videos in an S3-compatible bucket instead of on disk
# (AWS S3, R2, MinIO, Backblaze B2, ...). The bucket stays private.
# MEDIA_STORE=s3
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1        # R2 uses "auto"
# S3_ENDPOINT=               # leave unset for AWS; set for R2, MinIO, B2 (path-style)
# S3_PREFIX=comfy            # folder inside the bucket
